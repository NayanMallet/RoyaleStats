# Example env vars for local development
# Ports (optional)
ITEM_SERVICE_PORT=3003
USER_SERVICE_PORT=3002
PUBLIC_API_PORT=3001
API_GATEWAY_PORT=3000
CLASH_DATA_SERVICE_PORT=3004
LINK_SERVICE_PORT=3005
META_TRACKER_SERVICE_PORT=3006

# Database files inside containers (overridden by docker-compose volumes)
ITEM_DB_FILE=/app/item-service/database.sqlite
USER_DB_FILE=/app/user-service/database.sqlite
LINK_DB_FILE=/app/link-service/database.sqlite
META_DB_FILE=/app/meta-tracker-service/database.sqlite

# Secrets
JWT_SECRET=change_this_for_production

# Clash Royale API (REQUIRED - Get your key from https://developer.clashroyale.com)
CLASH_ROYALE_API_KEY=your_api_key_here
CLASH_ROYALE_BASE_URL=https://api.clashroyale.com/v1

# Service URLs (internal Docker network)
USER_SERVICE_URL=http://user-service:3002
ITEM_SERVICE_URL=http://item-service:3003
CLASH_DATA_SERVICE_URL=http://clash-data-service:3004
LINK_SERVICE_URL=http://link-service:3005
META_TRACKER_SERVICE_URL=http://meta-tracker-service:3006
PUBLIC_API_URL=http://public-api:3001
